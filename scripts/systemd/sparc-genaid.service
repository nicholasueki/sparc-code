[Unit]
Description=SPARC genaid (Hailo-10H STT / selector / salience service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robot-genai
WorkingDirectory=/home/robot-genai/sparc
Environment=PYTHONPATH=packages/common:packages/node_b
Environment=SPARC_CONFIG=/home/robot-genai/sparc/config/sparc.yaml
Environment=SPARC_NODE=b
ExecStart=/home/robot-genai/sparc_venv/bin/python -m sparc_node_b.genaid
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=10
StandardOutput=append:/var/log/sparc/genaid.log
StandardError=append:/var/log/sparc/genaid.log

[Install]
WantedBy=multi-user.target
