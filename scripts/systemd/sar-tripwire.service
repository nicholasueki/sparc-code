[Unit]
Description=SAR IMX500 vision tripwire (always-on person detection)
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
User=robot-vision
SupplementaryGroups=video
WorkingDirectory=/home/robot-vision/sar
Environment=PYTHONPATH=packages/common:packages/node_a
Environment=SAR_CONFIG=/home/robot-vision/sar/config/sar.yaml
Environment=SAR_NODE=a
ExecStart=/home/robot-vision/sar_venv/bin/python -m sar_node_a.perception.imx500_tripwire
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=10
StandardOutput=append:/var/log/sar/tripwire.log
StandardError=append:/var/log/sar/tripwire.log

[Install]
WantedBy=multi-user.target
