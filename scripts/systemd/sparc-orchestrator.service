[Unit]
Description=SPARC orchestrator (world model, scheduler, cognition dispatch)
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
User=robot-vision
WorkingDirectory=/home/robot-vision/sparc
Environment=PYTHONPATH=packages/common:packages/node_a
Environment=SPARC_CONFIG=/home/robot-vision/sparc/config/sparc.yaml
Environment=SPARC_NODE=a
ExecStart=/home/robot-vision/sparc_venv/bin/python -m sparc_node_a.orchestrator
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=10
StandardOutput=append:/var/log/sparc/orchestrator.log
StandardError=append:/var/log/sparc/orchestrator.log

[Install]
WantedBy=multi-user.target
