[Unit]
Description=SPARC face-identity enrichment (Hailo-8 SCRFD + ArcFace)
After=network-online.target mosquitto.service sparc-tripwire.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
User=robot-vision
WorkingDirectory=/home/robot-vision/sparc
Environment=PYTHONPATH=packages/common:packages/node_a
Environment=SPARC_CONFIG=/home/robot-vision/sparc/config/sparc.yaml
Environment=SPARC_NODE=a
ExecStart=/home/robot-vision/sparc_venv/bin/python -m sparc_node_a.perception.face_enrich
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=10
StandardOutput=append:/var/log/sparc/enrich.log
StandardError=append:/var/log/sparc/enrich.log

[Install]
WantedBy=multi-user.target
