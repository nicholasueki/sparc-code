[Unit]
Description=Lucas genaid (Hailo-10H STT / selector / salience service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robot-genai
WorkingDirectory=/home/robot-genai/lucas
Environment=PYTHONPATH=packages/common:packages/node_b
Environment=LUCAS_CONFIG=/home/robot-genai/lucas/config/lucas.yaml
Environment=LUCAS_NODE=b
ExecStart=/home/robot-genai/lucas_venv/bin/python -m lucas_node_b.genaid
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=10
StandardOutput=append:/var/log/lucas/genaid.log
StandardError=append:/var/log/lucas/genaid.log

[Install]
WantedBy=multi-user.target
